definition user {}

definition platform {
	relation admin: user
	permission administer = admin
}

definition group {
	relation member: user | group#member
}

definition role {
	relation member: user | group#member
}

definition project {
	relation view_granted: user | group#member | role#member
	relation edit_granted: user | group#member | role#member
	relation manage_members_granted: user | group#member | role#member
	permission view = view_granted
	permission edit = edit_granted
	permission manage_members = manage_members_granted
}

definition ticket {
	relation parent: project
	relation creator: user
	relation view_granted: user | group#member | role#member
	relation edit_granted: user | group#member | role#member
	permission view = view_granted + creator + parent->view
	permission edit = edit_granted + parent->edit
	permission manage_members = parent->manage_members
}